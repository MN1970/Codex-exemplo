# Copie para .env e ajuste. Nenhum valor real de produção aqui.

ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Postgres local (docker-compose) ou DSN do Supabase em produção
DATABASE_URL=postgresql://manta:manta@db:5432/manta

# Supabase (RAG pgvector)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Auth (RS256 — assinatura assimétrica; ver auth.py)
# Vazias = auth.py gera um par RSA efêmero em memória (só para dev/testes).
# Em produção, gere com:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=manta-maestro-auth
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30
ORG_HEADER_NAME=X-Org-Id

# Legado — /admin/token (dev) só usa isto se JWT_ALGORITHM cair para HS256
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=480

# MCP gateway (mcp/client.py — gateway custom único)
MCP_GATEWAY_URL=http://localhost:8765
MCP_REQUEST_TIMEOUT_SECONDS=30

# MCP remoto (mcp/integration.py — client multi-server, protocolo real JSON-RPC 2.0)
# Vazio = integração desabilitada; o backend sobe normalmente sem essas tools.
GITHUB_MCP_URL=
GITHUB_MCP_TOKEN=
SUPABASE_MCP_URL=
SUPABASE_MCP_TOKEN=
MICROSOFT_365_MCP_URL=
MICROSOFT_365_MCP_TOKEN=

# Claude API (agent executor via routers/executor.py)
# Vazio = execução de agentes desabilitada; /executor retorna 503.
CLAUDE_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-3-5-sonnet-20241022
CLAUDE_OPUS_MODEL=claude-3-opus-20250219
CLAUDE_MAX_TOKENS=4096
CLAUDE_STREAMING_TIMEOUT=120

# ML — all-MiniLM-L6-v2 (Sentence Transformers local, dim 384). Trocar
# de modelo exige atualizar EMBEDDING_DIMENSIONS + rodar uma migration
# Alembic nova (ver alembic/versions/0004_embedding_dim_384.py).
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
