        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Accuracy",
            "desc": true
          }
        ]
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "routing_accuracy",
          "format": "table",
          "instant": true,
          "intervalFactor": 2,
          "refId": "A"
        }
      ],
      "title": "Routing Accuracy by Agent",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "agent": 0,
              "Value": 2
            },
            "renameByName": {
              "agent": "Agent",
              "Value": "Accuracy"
            }
          }
        }
      ],
      "type": "table"
    },
