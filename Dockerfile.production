# Maestro OS v6.0 - Minimal Docker Image
FROM python:3.11-slim

LABEL maintainer="mneves@mantaassociados.com"
LABEL description="Maestro OS v6.0 - Parallel Agent Orchestration System"
LABEL version="6.0.0"

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 maestro

# Set working directory
WORKDIR /opt/maestro

# Copy application code
COPY --chown=maestro:maestro . /opt/maestro/

# Install minimal Python dependencies
RUN pip install --no-cache-dir pydantic==2.5.0

# Set environment
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/opt/maestro APP_ENV=production

# Create log directory
RUN mkdir -p /var/log/maestro && chown maestro:maestro /var/log/maestro

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=2 \
    CMD python3 -c "print('healthy')" || exit 1

# Expose port
EXPOSE 8080

# Run as non-root
USER maestro

# Entry point - run the __main__ module
CMD ["python3", "-m", "maestro"]
