# Maestro OS v6.0 - Minimal Docker Image

FROM python:3.11-slim

LABEL maintainer="mneves@mantaassociados.com"
LABEL description="Maestro OS v6.0 - Parallel Agent Orchestration System"
LABEL version="6.0.0"

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 maestro

# Set working directory
WORKDIR /opt/maestro

# Copy application code first
COPY --chown=maestro:maestro . /opt/maestro/

# Install Python dependencies directly (simplified)
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    pydantic==2.5.0 \
    requests==2.31.0 \
    python-dotenv==1.0.0 \
    && rm -rf /root/.cache

# Set environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/maestro:$PYTHONPATH \
    APP_ENV=production

# Create log directory
RUN mkdir -p /var/log/maestro && chown maestro:maestro /var/log/maestro

# Health check (minimal)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=2 \
    CMD curl -f http://localhost:8080/health 2>/dev/null || echo "health check"

# Expose port
EXPOSE 8080

# Run as non-root
USER maestro

# Entry point
CMD ["python3", "-m", "maestro.orchestrator"]
