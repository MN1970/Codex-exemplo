# Manta Maestro — agent-registry env vars
# Copy to .env (never commit the real .env) and fill in real values.

# --- Supabase (server-side service role — never expose client-side) ---
SUPABASE_URL=https://ogxxgvgtulrbbppshjie.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub webhook ---
GITHUB_WEBHOOK_SECRET=
AGENTS_REPO_ROOT=/path/to/local/checkout/of/Codex-exemplo
PORT=8787

# --- Self-test gate (Fase 3.1: "self-test roda 5 sample queries, <30s latency") ---
SELF_TEST_SAMPLE_SIZE=5
SELF_TEST_LATENCY_THRESHOLD_MS=30000

# --- A/B test rollout (Fase 3.1: "5% tráfego por 1 semana" → promotion) ---
AB_TEST_TRAFFIC_PERCENT=5
AB_TEST_DURATION_DAYS=7

# --- Promotion gate thresholds checked at the end of the A/B window ---
PROMOTION_MIN_SUCCESS_RATE=0.9
PROMOTION_MAX_ERROR_RATE=0.1
PROMOTION_MAX_AVG_LATENCY_MS=30000
