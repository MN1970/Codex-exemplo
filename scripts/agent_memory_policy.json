      "enabled": true
    },
    "s3_ferrovia": {
      "agent_id": "manta-03-s3",
      "ttl_minutes": 480,
      "memory_limit_mb": 100,
      "chunk_limit": 10000,
      "enabled": true
    },
    "s4_metro": {
      "agent_id": "manta-03-s4",
      "ttl_minutes": 480,
      "memory_limit_mb": 100,
      "chunk_limit": 10000,
      "enabled": true
    },
    "s6_portos": {
      "agent_id": "manta-03-s6",
      "ttl_minutes": 480,
      "memory_limit_mb": 100,
      "chunk_limit": 10000,
      "enabled": true
    },
    "s7_aeroportos": {
      "agent_id": "manta-03-s7",
      "ttl_minutes": 480,
      "memory_limit_mb": 100,
      "chunk_limit": 10000,
      "enabled": true
    },
    "s8_saneamento": {
      "agent_id": "manta-03-s8",
      "ttl_minutes": 480,
      "memory_limit_mb": 100,
      "chunk_limit": 10000,
      "enabled": true,
      "comment": "PRIORIDADE AySA"
    },
    "s9_energia": {
      "agent_id": "manta-03-s9",
      "ttl_minutes": 480,
      "memory_limit_mb": 100,
      "chunk_limit": 10000,
      "enabled": true,
      "comment": "ANEEL focus"
    },
    "s10_barragens": {
      "agent_id": "manta-03-s10",
      "ttl_minutes": 480,
      "memory_limit_mb": 100,
      "chunk_limit": 10000,
      "enabled": true
    }
  },

  "apscheduler_integration": {
    "description": "APScheduler trigger configuration para purga diária",
    "trigger_template": {
      "name": "agent-memory-purge-daily",
      "cron": "0 3 * * *",
      "prompt": "Execute purga de agent_memory conforme R10: DELETE entries com expires_at <= NOW() ou user_rating < 2 AND age > 7 days. Registre metrics em agent_memory_metrics. Se bytes_freed > 10GB, envie Slack alert para #agent-ops.",
      "environment": "production",
      "timeout_seconds": 1800,
      "retry_on_failure": true,
      "max_retries": 3
    },
    "feedback_loop_trigger": {
      "name": "embedding-retraining-weekly",
      "cron": "0 3 * * 0",
      "prompt": "Weekly: fetch user_ratings >= 4 das últimas 7 dias, retrain embedding model com fine-tuning. Update checksum em VERSIONS.json. Redeploy embeddings.",
      "environment": "production"
    }
  },

  "deployment_notes": {
    "phase": "Phase 4 — Observabilidade (T-12h antes go-live)",
    "pre_requisites": [
      "Supabase project configured",
      "pgvector extension enabled",
      "RLS policies activated",
      "APScheduler setup (Temporal/Celery)",
      "Slack webhook configured (opcional)"
    ],
    "post_deployment": [
      "Validate purge_expired_agent_memory() function via SQL",
      "Test RLS isolation: verify agents can't see each other's data",
      "Test dry-run: python scripts/agent_memory_purge.py --dry-run",
      "Monitor Grafana dashboard for 24h",
      "Alert if > 3 timeouts/hour em um agente"
    ],
    "rollback": {
      "procedure": "Revert CLAUDE.md → v4.2, desativar R10 (manter R1-R5)",
      "steps": [
        "Disable APScheduler trigger (agent-memory-purge-daily)",
        "Restore RAG from backup (v4.9)",
        "Revert skills → v4.9 via VERSIONS.json checksum",
        "Log incident em ROLLBACK_LOG.md"
      ]
    }
  }
}
