# ============================================================================
# .env.example — Template de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env em controle de versão
# ============================================================================

# --- AMBIENTE E CONFIGURAÇÃO GERAL ---
# Ambiente de execução (development, staging, production)
NODE_ENV=development

# Porta do servidor HTTP/HTTPS
PORT=3000

# Nível de logging (error, warn, info, debug, trace)
LOG_LEVEL=info

# ============================================================================
# ANTHROPIC API — Claude Models
# ============================================================================

# Chave de API da Anthropic (obtém em https://console.anthropic.com)
ANTHROPIC_API_KEY=sk_your_key_here_xxx_xxxxxxxxxxxxxxxxxx

# Modelo Claude a usar (claude-opus-4-1, claude-sonnet-4, claude-haiku-4-5-20251001)
CLAUDE_MODEL=claude-opus-4-1

# Timeout em milissegundos para requisições ao Claude API
CLAUDE_API_TIMEOUT_MS=60000

# Máximo de tokens na resposta
CLAUDE_MAX_TOKENS=4096

# ============================================================================
# SUPABASE — Backend as a Service
# ============================================================================

# URL do projeto Supabase (ex: https://xxxxx.supabase.co)
SUPABASE_URL=https://your_project.supabase.co

# Chave pública do Supabase (anon key, safe para expor no cliente)
SUPABASE_KEY=your_anon_key_here_xxx

# Chave de serviço do Supabase (SECRETO — apenas servidor)
SUPABASE_SERVICE_ROLE=your_service_role_key_xxx

# Timeout para conexões Supabase (ms)
SUPABASE_TIMEOUT_MS=15000

# ============================================================================
# GITHUB — Integração e API
# ============================================================================

# Token de acesso pessoal do GitHub (GitHub PAT)
GITHUB_TOKEN=ghp_your_token_here_xxx_xxxxxxxxxxxxxxxxxx

# Proprietário (user ou organização) do repositório
GITHUB_OWNER=manta-associados

# Nome do repositório
GITHUB_REPO=codex-exemplo

# Branch padrão (main, develop)
GITHUB_DEFAULT_BRANCH=main

# ============================================================================
# MICROSOFT GRAPH API — SharePoint, Teams, Outlook
# ============================================================================

# Token de autenticação Microsoft Graph (OAuth 2.0 access token)
MS_GRAPH_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...your_token_xxx

# ID do tenant Azure AD
MS_TENANT_ID=12345678-1234-1234-1234-123456789012

# ID da aplicação registrada no Azure AD
MS_APP_ID=87654321-4321-4321-4321-210987654321

# Segredo da aplicação (SECRETO)
MS_APP_SECRET=your_app_secret_xxx

# Timeout para requisições Graph API (ms)
MS_GRAPH_TIMEOUT_MS=30000

# ============================================================================
# BANCO DE DADOS — PostgreSQL (Supabase)
# ============================================================================

# URL de conexão direta PostgreSQL (opcional, para queries diretas)
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Pool de conexões mínimo
DATABASE_POOL_MIN=2

# Pool de conexões máximo
DATABASE_POOL_MAX=10

# ============================================================================
# CACHE E SINCRONIZAÇÃO
# ============================================================================

# TTL (Time To Live) do cache em segundos
CACHE_TTL_SECONDS=3600

# Intervalo de sincronização com serviços externos (segundos)
SYNC_INTERVAL_SECONDS=600

# TTL para cache em memória (segundos)
MEMORY_CACHE_TTL=1800

# Tipo de cache (memory, redis)
CACHE_BACKEND=memory

# ============================================================================
# NOTIFICAÇÕES E COMUNICAÇÃO
# ============================================================================

# Email para notificações administrativas
ADMIN_EMAIL=admin@mantaassociados.com

# Serviço SMTP (sendgrid, mailgun, aws-ses)
SMTP_SERVICE=sendgrid

# Chave da API de email
SMTP_API_KEY=SG.your_sendgrid_key_xxx

# Host SMTP (se usar SMTP direto)
SMTP_HOST=smtp.sendgrid.net

# Porta SMTP
SMTP_PORT=587

# ============================================================================
# AUTENTICAÇÃO E SEGURANÇA
# ============================================================================

# Segredo para assinar JWT tokens
JWT_SECRET=your_jwt_secret_key_should_be_very_long_and_random_xxx

# Algoritmo JWT
JWT_ALGORITHM=HS256

# TTL do JWT access token (segundos)
JWT_EXPIRES_IN=3600

# TTL do JWT refresh token (segundos)
JWT_REFRESH_EXPIRES_IN=604800

# Hash rounds para bcrypt
BCRYPT_ROUNDS=12

# ============================================================================
# RATE LIMITING E PROTEÇÃO
# ============================================================================

# Requisições máximas por minuto (rate limit)
RATE_LIMIT_MAX_REQUESTS=100

# Janela de rate limiting (minutos)
RATE_LIMIT_WINDOW_MINUTES=15

# Habilitar CORS (true/false)
CORS_ENABLED=true

# Origem CORS permitida (comma-separated ou *)
CORS_ORIGIN=https://localhost:3000,https://app.mantaassociados.com

# ============================================================================
# LOGGING E MONITORAMENTO
# ============================================================================

# Serviço de logging remoto (sentry, datadog, none)
LOG_SERVICE=sentry

# DSN (Data Source Name) para Sentry
SENTRY_DSN=https://your_key@sentry.io/your_project_id

# Ambiente do Sentry (development, staging, production)
SENTRY_ENVIRONMENT=development

# Rastrear performance (true/false)
TRACE_PERFORMANCE=false

# ============================================================================
# COMPLIANCE E PRIVACIDADE
# ============================================================================

# Versão da LGPD/GDPR consent (v1, v2)
CONSENT_VERSION=v1

# Retenção de dados em dias (para LGPD)
DATA_RETENTION_DAYS=365

# Criptografar dados sensíveis no repouso (true/false)
ENCRYPT_AT_REST=true

# Chave de criptografia (AES-256)
ENCRYPTION_KEY=your_encryption_key_should_be_32_bytes_long_xxx

# ============================================================================
# FEATURE FLAGS E CONFIGURAÇÕES AVANÇADAS
# ============================================================================

# Modo debug (true/false)
DEBUG=false

# Habilitar API de testes (true/false)
ENABLE_TEST_API=false

# Versão da API
API_VERSION=v1

# ============================================================================
# INTEGRAÇÕES EXTERNAS
# ============================================================================

# Chave da API OpenAI (opcional, para fallback)
OPENAI_API_KEY=sk_test_your_openai_key_xxx

# Chave da API Google Maps (se usar geolocalização)
GOOGLE_MAPS_API_KEY=your_google_maps_key_xxx

# Chave da API Stripe (processamento de pagamentos)
STRIPE_SECRET_KEY=sk_live_your_stripe_key_xxx

# Chave pública Stripe
STRIPE_PUBLIC_KEY=pk_live_your_public_key_xxx

# ============================================================================
# URLS E ENDPOINTS
# ============================================================================

# URL base da aplicação
APP_URL=http://localhost:3000

# URL da API
API_URL=http://localhost:3000/api

# URL do frontend (para CORS e redirects)
FRONTEND_URL=http://localhost:3000

# URL do webhook para eventos externos
WEBHOOK_URL=https://your_domain.com/webhooks

# ============================================================================
# DOCUMENTAÇÃO
# ============================================================================
# Para completar o setup:
# 1. Copie este arquivo para .env (não commite em git)
# 2. Preencha com seus valores reais em desenvolvimento
# 3. Em produção, use secrets management (AWS Secrets Manager, Azure Key Vault, etc)
# 4. Nunca commite credenciais reais
# ============================================================================
