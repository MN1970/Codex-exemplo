# ============================================================================
# Manta Maestro - Environment Configuration Template
# ============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control — it's in .gitignore.
# No real production secrets are included below.

# ============================================================================
# Application Environment
# ============================================================================
# development | staging | production
ENVIRONMENT=development

# Enable debug mode (logs, error details, etc)
DEBUG=true

# Log level: debug | info | warning | error | critical
LOG_LEVEL=info

# ============================================================================
# Database — PostgreSQL 15 with pgvector
# ============================================================================
# Used by docker-compose.yml for initialization
POSTGRES_USER=manta
POSTGRES_PASSWORD=mantadev

# SQLAlchemy async connection string
# docker-compose: postgresql://manta:mantadev@db:5432/manta
# Supabase: postgresql://[user]:[password]@db.supabase.co:5432/postgres
DATABASE_URL=postgresql://manta:mantadev@db:5432/manta

# ============================================================================
# FastAPI Backend
# ============================================================================
# Host binding (0.0.0.0 = all interfaces, for Docker)
HOST=0.0.0.0

# Port
PORT=8000

# Number of Uvicorn workers (1 per ~2GB RAM; usually 2-4 for dev)
API_WORKERS=2

# CORS allowed origins (JSON array)
# Default: http://localhost:3000 (legacy), http://localhost:5173 (Vite), http://localhost:8000 (FastAPI docs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ============================================================================
# Authentication — RS256 Asymmetric (Production-Ready)
# ============================================================================
# Algorithm: RS256 (recommended) or HS256 (legacy, not recommended)
JWT_ALGORITHM=RS256

# For RS256, provide PEM-encoded keys (base64 or literal \n in value).
# Generate in dev/test with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
#
# In .env, encode as single-line with literal \n:
#   JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n....\n-----END RSA PRIVATE KEY-----"
#
# Leave empty = auth.py will generate ephemeral RSA pair in memory (dev/test only).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# JWT claims
JWT_ISSUER=manta-maestro-auth
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30

# Header name for tenant isolation (multi-tenant routing)
ORG_HEADER_NAME=X-Org-Id

# Fallback for HS256 mode (legacy; JWT_ALGORITHM=HS256 only)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=480

# ============================================================================
# MCP Gateway & Integration
# ============================================================================
# Local MCP gateway (gateway.py, single unified endpoint)
MCP_GATEWAY_URL=http://mcp-gateway:8765
MCP_REQUEST_TIMEOUT_SECONDS=30

# Remote MCP servers (JSON-RPC 2.0 multi-server protocol)
# Leave empty to disable integrations; endpoints will return 501 if MCP server is missing.

# GitHub MCP (issues, PRs, code search, etc)
GITHUB_MCP_URL=
GITHUB_MCP_TOKEN=

# Supabase MCP (database, storage, edge functions)
SUPABASE_MCP_URL=
SUPABASE_MCP_TOKEN=

# Microsoft 365 MCP (Teams, SharePoint, Outlook)
MICROSOFT_365_MCP_URL=
MICROSOFT_365_MCP_TOKEN=

# ============================================================================
# Claude API — Agent Executor
# ============================================================================
# Anthropic API key for agent execution (routers/executor.py)
# Leave empty = agent endpoints return 503 Service Unavailable.
CLAUDE_API_KEY=

# Model selection
CLAUDE_DEFAULT_MODEL=claude-3-5-sonnet-20241022
CLAUDE_OPUS_MODEL=claude-3-opus-20250219

# Token & timeout limits
CLAUDE_MAX_TOKENS=4096
CLAUDE_STREAMING_TIMEOUT=120

# ============================================================================
# ML — Embeddings
# ============================================================================
# Sentence Transformers model for RAG embeddings (local, no API calls)
# Changing this requires updating EMBEDDING_DIMENSIONS and running alembic migrations.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# ============================================================================
# Supabase (RAG & Optional RAG pgvector)
# ============================================================================
# If using Supabase for RAG (instead of local PostgreSQL):
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ============================================================================
# Redis — Caching & Sessions
# ============================================================================
# Docker-compose: redis://redis:6379/0
# Can use Redis Cloud or any Redis instance
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=3600
REDIS_SESSION_TTL_SECONDS=86400

# ============================================================================
# Email — Feedback Alerts & Notifications
# ============================================================================
# SMTP configuration for sending feedback alerts, error summaries, etc
SMTP_HOST=${SMTP_HOST:-smtp.gmail.com}
SMTP_PORT=${SMTP_PORT:-587}
SMTP_TLS=${SMTP_TLS:-true}
SMTP_USERNAME=${SMTP_USERNAME:-}
SMTP_PASSWORD=${SMTP_PASSWORD:-}
SMTP_FROM=${SMTP_FROM:-noreply@mantaassociados.com}

# Alert recipients (JSON array of email addresses)
ALERT_RECIPIENTS=["devops@mantaassociados.com"]

# ============================================================================
# React Frontend (Vite)
# ============================================================================
# Backend API endpoint (frontend uses this to call backend)
# Default: http://localhost:8000
# For Docker, this is usually http://backend:8000 (internal) or http://localhost:8000 (external)
VITE_API_URL=http://localhost:8000

# API request timeout (milliseconds)
VITE_API_TIMEOUT=30000

# Enable authentication UI (login, logout, etc)
VITE_AUTH_ENABLED=true

# Log level in browser console
# Choices: debug | info | warn | error
VITE_LOG_LEVEL=info

# Feature flags (enable/disable frontend features)
VITE_ENABLE_RAG=true
VITE_ENABLE_AGENTS=true
VITE_ENABLE_ADMIN=true

# ============================================================================
# Development & Testing
# ============================================================================
# Enable hot-reload in development (Uvicorn --reload, Vite dev server)
HOT_RELOAD=true

# Seed test data on startup (for development)
SEED_TEST_DATA=false

# Test data settings
TEST_DATA_AGENTS=10
TEST_DATA_RAG_CHUNKS=100

# ============================================================================
# SharePoint Integration (Optional)
# ============================================================================
# For syncing projects, agents, and documents from SharePoint
SHAREPOINT_SITE_URL=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TENANT_ID=

# ============================================================================
# Analytics & Monitoring (Optional)
# ============================================================================
# Sentry error tracking
SENTRY_DSN=

# DataDog APM
DATADOG_API_KEY=

# PostHog product analytics
POSTHOG_API_KEY=

# ============================================================================
# Internal / Advanced Configuration
# ============================================================================
# Do not change unless you know what you're doing.

# Alembic database migration directory
ALEMBIC_INI=./manta-backend/alembic.ini

# API documentation endpoints
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# Worker process model (auto | sync | asyncio)
# Keep as default unless testing specific concurrency models
UVICORN_WORKER_CLASS=auto
