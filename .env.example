# Maestro APScheduler v5.0 — Environment Variables
# Copy this file to .env and fill in actual values
# DO NOT commit .env to version control

# ===== Python & Logging =====
PYTHONUNBUFFERED=1
MAESTRO_ENV=production
MAESTRO_LOG_LEVEL=INFO

# ===== Database (PostgreSQL) =====
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://maestro:password_here@localhost:5432/maestro_v5

# ===== Slack Integration =====
# Get webhook URL from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# ===== Docker Credentials (for CI/CD) =====
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_access_token
DOCKER_REGISTRY=docker.io

# ===== Grafana Configuration =====
GRAFANA_PASSWORD=secure_grafana_password_here
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=secure_password_here

# ===== Scheduler Configuration =====
SCHEDULER_MAX_INSTANCES=1
SCHEDULER_COALESCE=true
SCHEDULER_TIMEZONE=UTC

# ===== Job Timeouts (seconds) =====
JOB_TIMEOUT_RAG_REINDEX=600
JOB_TIMEOUT_MEMORY_PURGE=300
JOB_TIMEOUT_EMBEDDING_RETRAIN=1800
JOB_TIMEOUT_TIERING_AUDIT=300

# ===== Monitoring & Metrics =====
PROMETHEUS_SCRAPE_INTERVAL=30s
PROMETHEUS_RETENTION=30d
ALERTMANAGER_ROUTE_GROUP_WAIT=30s
ALERTMANAGER_ROUTE_GROUP_INTERVAL=5m

# ===== GitHub Actions (if using CI/CD) =====
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPOSITORY=mantaassociados/Codex-exemplo

# ===== Optional: Supabase Integration =====
# For advanced features (comment out if not using)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Optional: OpenTelemetry (APM) =====
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20your_token
