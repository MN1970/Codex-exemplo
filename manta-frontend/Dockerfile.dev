# Development stage for Vite dev server with hot-reload
FROM node:22-alpine AS dev

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --prefer-offline --no-audit

# Copy source code
COPY . .

EXPOSE 5173

# Start Vite dev server with HMR enabled
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
