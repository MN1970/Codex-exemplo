# Cowork Webhook Configuration

# HMAC secret for webhook signature validation
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret-key-change-me-in-production

# Server port
PORT=3000

# Retry configuration
WEBHOOK_MAX_RETRIES=3
WEBHOOK_INITIAL_BACKOFF_MS=1000
WEBHOOK_MAX_BACKOFF_MS=30000

# Audit logging
WEBHOOK_AUDIT_LOG_PATH=./logs/webhook-audit.log

# Logger level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
