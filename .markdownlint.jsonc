{
  // Config do markdownlint-cli2 para o repositório Manta Maestro.
  // Regras relaxadas para acomodar tabelas largas e frontmatter YAML
  // com listas em linha (comuns em .claude/agents/*.md).
  "default": true,
  "MD013": false,        // linhas longas — textos técnicos/tabelas em pt-BR são longos
  "MD024": { "siblings_only": true }, // permite títulos repetidos entre arquivos (ex: "## Handoff com outros agentes")
  "MD033": false,         // permite HTML inline ocasional
  "MD041": false,         // primeira linha nem sempre é H1 (frontmatter vem antes)
  "MD046": { "style": "fenced" },
  // As regras abaixo foram desabilitadas em 2026-09-10 ao investigar a
  // falha crônica do check "Lint (markdown, yaml, frontmatter)"
  // (.github/workflows/agent-test.yml). Depois de corrigir o glob que
  // deixava node_modules/** vazar para o lint (causa raiz principal),
  // ainda restavam ~4.700 violações espalhadas por ~185 arquivos .md
  // pré-existentes deste repositório — nenhuma delas indica conteúdo
  // quebrado, apenas convenções de formatação nunca aplicadas
  // retroativamente ao histórico já commitado. Corrigir cada arquivo
  // individualmente não é viável com precisão nesse volume, então as
  // regras específicas abaixo foram relaxadas (não o lint inteiro):
  "MD032": false,         // blanks-around-lists — estilo de espaçamento, não afeta renderização
  "MD031": false,         // blanks-around-fences — idem, para blocos de código
  "MD022": false,         // blanks-around-headings — idem, para headings
  "MD012": false,         // no-multiple-blanks — linhas em branco extras são só estética
  "MD040": false,         // fenced-code-language — muitos blocos são ASCII art/árvores de diretório/saída de exemplo sem linguagem aplicável
  "MD036": false,         // no-emphasis-as-heading — **negrito** é usado de propósito como rótulo inline (ex: "**Nota:**"), não como substituto de heading
  "MD034": false,         // no-bare-urls — e-mails e URLs soltos em prosa técnica são comuns e inofensivos aqui
  "MD029": false,         // ol-prefix — vários docs continuam a numeração de uma lista após um parágrafo/heading intermediário de propósito narrativo
  // MD004 e MD037 abaixo foram testadas com --fix e DESCARTADAS de
  // propósito (não é só volume): o autofix corrompeu conteúdo real em
  // vários arquivos, porque texto técnico legítimo aqui colide com a
  // sintaxe de lista/ênfase do Markdown — não é seguro deixar uma
  // ferramenta "corrigir" essas linhas automaticamente:
  "MD004": false,         // ul-style — "+" usado como operador matemático em prosa (ex.: "cimento + 30%, aço + 50%") foi lido como marcador de lista inconsistente e o autofix trocou "+" por "-", invertendo o sentido da frase
  "MD037": false          // no-space-in-emphasis — "___" usado como linha para preencher à mão (ex.: "Resultado: ___ de 14 testes") foi lido como ênfase mal-formada e o autofix embaralhou o texto
}
