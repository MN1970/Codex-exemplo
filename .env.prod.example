# ========================================
# MAESTRO SYNC SERVER — PRODUCTION CONFIG
# ========================================

# Environment
NODE_ENV=production
MCP_PORT=3001
LOG_LEVEL=info

# ========================================
# ANTHROPIC / CLAUDE AI
# ========================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# COWORK API
# ========================================
COWORK_API_URL=https://cowork.seu-dominio.com/api
COWORK_API_TOKEN=token_xxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# MCP SERVER SECURITY
# ========================================
MCP_API_TOKEN=super-secret-token-minimum-32-characters-long

# ========================================
# DOCKER / COMPOSE
# ========================================
COMPOSE_PROJECT_NAME=maestro-prod

# ========================================
# OPTIONAL: MONITORING
# ========================================
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# DATADOG_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# ========================================
# OPTIONAL: DATABASE (se usar Supabase)
# ========================================
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxxxxxx

# ========================================
# INSTRUCTIONS
# ========================================
#
# 1. Copy this file to .env.prod
# 2. Replace all xxxxx with real values
# 3. NEVER commit .env.prod to git
# 4. Add to .gitignore if not already there
# 5. Use: docker-compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# ========================================
