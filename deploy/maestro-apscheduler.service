[Unit]
Description=Maestro APScheduler Background Tasks
Documentation=https://mantaassociados.com/manta-maestro/apscheduler
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=maestro
Group=maestro
WorkingDirectory=/opt/maestro

# Environment
Environment="PYTHONUNBUFFERED=1"
Environment="MAESTRO_ENV=production"
Environment="MAESTRO_LOG_LEVEL=INFO"

# Executable
ExecStart=/usr/bin/python3 /opt/maestro/scripts/apscheduler_setup.py

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=5

# Resource limits
MemoryLimit=512M
CPUQuota=50%
TasksMax=100

# Timeout
TimeoutStartSec=30
TimeoutStopSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/maestro /opt/maestro/.claude

# Output
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maestro-apscheduler

[Install]
WantedBy=multi-user.target
