# Copy to .env and fill in. All variables are optional; sensible
# defaults are baked into heartbeat-service.js.

# Postgres/Supabase connection string. If unset (or unreachable at
# startup), the service runs in cache-only degraded mode automatically.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# HTTP server
HEARTBEAT_PORT=8787
HEARTBEAT_HOST=0.0.0.0

# Optional shared-secret auth. Leave empty to disable (dev only).
HEARTBEAT_API_KEY=

# Heartbeat cadence sent by each agent (ms). Default 300000 = 5 min.
HEARTBEAT_INTERVAL_MS=300000

# How long without a heartbeat before an agent is presumed unhealthy
# (ms). Default 600000 = 2x the 5-min interval = 10 min.
HEARTBEAT_STALE_AFTER_MS=600000

# How long an agent must be continuously "unhealthy" before Maestro
# stops routing to it (ms). Default 600000 = 10 min, per spec.
HEARTBEAT_UNHEALTHY_GRACE_MS=600000

# Local disk cache used for graceful degradation when Postgres is
# unreachable (absolute or relative path).
HEARTBEAT_CACHE_FILE=./.cache/agent-health-cache.json

# How often to retry flushing cached writes back to Postgres (ms).
HEARTBEAT_CACHE_FLUSH_INTERVAL_MS=30000

# Verbose per-request logging.
HEARTBEAT_DEBUG=
