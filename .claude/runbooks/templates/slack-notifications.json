              }
            ]
          },
          {
            "type": "section",
            "fields": [
              {
                "type": "mrkdwn",
                "text": "*Triggered At:*\n{{TIMESTAMP}}"
              },
              {
                "type": "mrkdwn",
                "text": "*Affected Component:*\n{{COMPONENT}}"
              }
            ]
          },
          {
            "type": "section",
            "text": {
              "type": "mrkdwn",
              "text": "*Alert Details:*\n{{ALERT_CONDITION}} → {{METRIC_VALUE}} (threshold: {{THRESHOLD}})\nTime window: {{TIME_WINDOW}}"
            }
          },
          {
            "type": "section",
            "text": {
              "type": "mrkdwn",
              "text": "*Response Playbook:*\nFASE3-PRODUCTION-DEPLOYMENT.md → Scenario {{SCENARIO}}\n\n*Actions:*\n1. On-call @DevOps-lead investigating\n2. Checking <https://pagerduty.manta.internal|PagerDuty> for automated remediation\n3. Real-time: <https://grafana.manta.internal/d/fase3-deployment|Grafana dashboard>"
            }
          },
          {
            "type": "divider"
          },
          {
            "type": "context",
            "elements": [
              {
                "type": "mrkdwn",
                "text": "Status updates in this thread. Critical escalations: @ML-engineering-lead, @CTO"
              }
            ]
          }
        ]
      }
    },
