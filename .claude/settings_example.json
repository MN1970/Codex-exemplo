{
  "_comment": "Exemplo de .claude/settings.json com integração P6 (Observabilidade)",
  "_version": "2026-07-25",
  "_description": "Configuração completa para Maestro v5.0 com hooks, RAG, tiering, observabilidade",

  "model_tier": "sonnet-5",
  "context_window_tokens": 8000,
  "max_output_tokens": 2048,
  "temperature": 0.7,

  "hooks": {
    "SubagentStop": {
      "enabled": true,
      "handler": "./.claude/hooks/subagentstop_maestro_observability.py",
      "description": "Grava runs em maestro_runs quando subagente termina (P6 observabilidade)",
      "async": true,
      "timeout_ms": 5000,
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 1000
      }
    }
  },

  "maestro": {
    "enabled": true,
    "routing_strategy": "R1",
    "model_tiering": "R7",
    "fallback_policy": "R8",
    "feedback_loop": "R9",
    "memory_purge_policy": "R10"
  },

  "skill_version_pin": {
    "maestro": "v5.0",
    "agente-rodovias": "v5.0",
    "agente-oae": "v5.0",
    "agente-ferrovia": "v5.0",
    "agente-metro": "v5.0",
    "agente-saneamento": "v5.0",
    "agente-energia": "v5.0",
    "agente-portos": "v5.0",
    "agente-aeroportos": "v5.0",
    "agente-barragens": "v5.0",
    "agente-claims": "v5.0",
    "agente-contratual": "v5.0",
    "agente-imobiliario": "v5.0",
    "agente-orcamento": "v5.0",
    "agente-modelagem": "v5.0",
    "agente-cronograma": "v5.0",
    "agente-bd": "v5.0",
    "agente-apresentacoes": "v5.0",
    "agente-advisory": "v5.0",
    "agente-arquiteto-ia": "v5.0"
  },

  "rag": {
    "enabled": true,
    "hybrid_search": true,
    "bm25_weight": 0.4,
    "embedding_weight": 0.4,
    "reranker_weight": 0.2,
    "reranker_threshold": 0.5,
    "cache_ttl_days": 7,
    "collections": {
      "rodovias": "rod:v5.0:chunks",
      "oae": "oae:v5.0:chunks",
      "ferrovia": "fer:v5.0:chunks",
      "metro": "met:v5.0:chunks",
      "saneamento": "san:v5.0:chunks",
      "energia": "ene:v5.0:chunks",
      "portos": "por:v5.0:chunks",
      "aeroportos": "aer:v5.0:chunks",
      "barragens": "bar:v5.0:chunks"
    }
  },

  "observability": {
    "enabled": true,
    "logging_level": "INFO",
    "supabase": {
      "maestro_runs_table": "maestro_runs",
      "retention_hot_days": 90,
      "retention_archive_days": 365,
      "archive_cron": "0 2 * * *"
    },
    "grafana": {
      "dashboard_enabled": true,
      "refresh_interval": "30s",
      "data_source": "Supabase Maestro"
    },
    "metrics": {
      "error_rate_threshold_pct": 5,
      "timeout_rate_threshold_pct": 2,
      "latency_p99_threshold_ms": 30000
    },
    "alerts": {
      "slack_enabled": true,
      "slack_channel": "#agent-ops",
      "error_rate_check_interval_min": 5
    }
  },

  "tiering": {
    "complexity_score_weights": {
      "keywords_matched": 1.0,
      "rag_reranker_score_gt_70": 1.5,
      "files_to_process": 2.0,
      "cross_agent_references": 0.5
    },
    "decision_rules": {
      "haiku": {
        "input_tokens_max": 2000,
        "complexity_max": 3.0,
        "cost_per_1m_input": 0.08,
        "cost_per_1m_output": 0.24
      },
      "sonnet": {
        "input_tokens_max": 10000,
        "complexity_max": 6.0,
        "cost_per_1m_input": 3.0,
        "cost_per_1m_output": 15.0
      },
      "opus": {
        "input_tokens_max": null,
        "complexity_max": null,
        "cost_per_1m_input": 15.0,
        "cost_per_1m_output": 75.0
      }
    },
    "fallback_on_timeout_s": 60,
    "cascade_models": ["haiku-4-5", "sonnet-5", "opus-5"]
  },

  "sharepoint_routing": {
    "enabled": true,
    "site": "Manta.net",
    "drive": "Projetos",
    "routing_rules": {
      "agente-saneamento": {
        "folder": "03_Projetos/Saneamento/2026-AySA",
        "patterns": ["*.pdf", "*.dwg", "*.xlsx", "*.docx"],
        "priority": 100
      },
      "agente-energia": {
        "folder": "03_Projetos/Energia/ANEEL-2026",
        "patterns": ["*.pdf", "*.dwg", "*.xlsx", "RAP-*"],
        "priority": 100
      },
      "agente-portos": {
        "folder": "03_Projetos/Portos/ANTAQ",
        "patterns": ["*.pdf", "*.dwg", "*.xlsx"],
        "priority": 100
      },
      "agente-aeroportos": {
        "folder": "03_Projetos/Aeroportos/ANAC-2026",
        "patterns": ["*.pdf", "RBAC-*", "*.xlsx"],
        "priority": 100
      },
      "agente-barragens": {
        "folder": "03_Projetos/Barragens/ICOLD-Registry",
        "patterns": ["*.pdf", "*.dwg", "SIGBM-*"],
        "priority": 100
      }
    }
  },

  "permissions": {
    "allow_bash_commands": true,
    "allow_file_read": true,
    "allow_file_write": true,
    "allow_git_operations": true,
    "allow_docker": false,
    "allow_external_api": true,
    "supabase_project_id": "${SUPABASE_PROJECT_ID}",
    "sharepoint_site_id": "${SHAREPOINT_SITE_ID}"
  },

  "environment_variables": {
    "SUPABASE_URL": "${SUPABASE_URL}",
    "SUPABASE_KEY": "${SUPABASE_KEY}",
    "SUPABASE_PROJECT_ID": "${SUPABASE_PROJECT_ID}",
    "POSTGRES_CONNECTION_STRING": "${POSTGRES_CONNECTION_STRING}",
    "SHAREPOINT_SITE_ID": "${SHAREPOINT_SITE_ID}",
    "SLACK_WEBHOOK_URL": "${SLACK_WEBHOOK_URL}",
    "LOG_LEVEL": "INFO"
  },

  "logging": {
    "level": "INFO",
    "format": "[%(asctime)s] %(name)s - %(levelname)s - %(message)s",
    "file": "/tmp/maestro.log",
    "max_size_mb": 100,
    "backup_count": 5
  },

  "performance": {
    "cache_embeddings": true,
    "cache_rag_results": true,
    "parallel_rag_search": true,
    "index_batch_size": 1000,
    "timeout_seconds": 300
  },

  "debug": {
    "enabled": false,
    "verbose_routing": false,
    "trace_rag_queries": false,
    "dump_context_window": false
  }
}
